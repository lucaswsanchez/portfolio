---
// The whole single-page site. Rendered once per language by src/pages/index.astro (en)
// and src/pages/es/index.astro (es); all text comes from src/i18n.
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Section from "./Section.astro";
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";
import Backdrop from "./Backdrop.astro";
import { profile } from "../data/profile";
import { visibleProjects } from "../data/projects";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);

const headerLinks = [
  { label: dict.ui.downloadCv, href: dict.cv.href, icon: "file" as const, kind: "cv" },
  { label: "GitHub", href: profile.github, icon: "github" as const, kind: "external" },
  { label: "LinkedIn", href: profile.linkedin, icon: "linkedin" as const, kind: "external" },
  { label: dict.ui.email, href: `mailto:${profile.email}`, icon: "mail" as const, kind: "mail" },
];
const [featured, ...rest] = visibleProjects;
const paired = rest.find((p) => p.pairedWith === featured?.id);
const pairNote = paired ? dict.projects[paired.id].pairNote : undefined;
const year = new Date().getFullYear();
---

<Base lang={lang}>
  <Nav lang={lang} />
  <Backdrop />
  <main id="main" class="mx-auto max-w-3xl px-5 sm:px-8">
    <!-- Header -->
    <section id="top" class="pt-24 pb-16 sm:pt-28 sm:pb-20" aria-label={dict.ui.intro}>
      <div class="rise mb-6 flex items-center gap-3" style="--i:0">
        {
          profile.photo && (
            <img
              src={profile.photo}
              alt={dict.ui.photoAlt}
              width="72"
              height="72"
              fetchpriority="high"
              class="size-14 shrink-0 rounded-full object-cover ring-1 ring-line ring-offset-2 ring-offset-bg sm:size-[72px]"
            />
          )
        }
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-bg/80 px-3 py-1 text-xs font-medium text-muted"
        >
          <span class="size-2 shrink-0 rounded-full bg-emerald-500/90" aria-hidden="true"></span>
          {dict.ui.openToWork}
        </p>
      </div>
      <h1 class="rise text-[2.6rem] leading-[1.05] font-semibold tracking-[-0.035em] sm:text-6xl" style="--i:1">
        {profile.name}
      </h1>
      <p class="rise mt-4 text-base text-fg/85 sm:text-lg" style="--i:2">
        <span class="block font-medium text-fg/90">{dict.hero.title}</span>
        <span class="mt-1 block text-[15px] text-muted sm:text-base">{dict.hero.subtitle}</span>
      </p>
      <p class="rise mt-2 flex items-center gap-1.5 text-sm text-muted" style="--i:2">
        <Icon name="pin" class="size-3.5 shrink-0" />
        {dict.hero.location}
      </p>

      <ul class="rise mt-8 flex flex-wrap gap-2" style="--i:3" aria-label={dict.ui.profilesAndContact}>
        {
          headerLinks.map((l) => (
            <li>
              <a
                href={l.href}
                {...(l.kind === "external" ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                {...(l.kind === "cv" ? { download: dict.cv.fileName, "data-cv": lang } : {})}
                class:list={[
                  "inline-flex min-h-11 items-center gap-2 rounded-lg border px-3.5 text-sm transition-colors sm:min-h-0 sm:px-3 sm:py-1.5",
                  l.kind === "cv"
                    ? "border-fg bg-fg font-medium text-bg hover:opacity-85"
                    : "border-line text-muted hover:border-fg/25 hover:text-fg",
                ]}
              >
                <Icon name={l.icon} class="size-4" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="flex flex-col gap-16 pb-20 sm:gap-20">
      <Section id="about" index="01" title={dict.sections.about}>
        <div class="space-y-4 leading-relaxed text-fg/85">
          {dict.about.map((p) => <p>{p}</p>)}
        </div>
      </Section>

      <Section id="skills" index="02" title={dict.sections.skills} navGroup="about">
        <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-[8rem_1fr]">
          {
            dict.skills.map((s) => (
              <>
                <dt class="text-sm font-medium sm:pt-1">{s.group}</dt>
                <dd class="-mt-2 flex flex-wrap gap-1.5 sm:mt-0">
                  {s.items.map((item) => (
                    <span class="rounded-md bg-surface px-2 py-1 font-mono text-xs text-muted ring-1 ring-line">
                      {item}
                    </span>
                  ))}
                </dd>
              </>
            ))
          }
        </dl>
      </Section>

      <Section id="projects" index="03" title={dict.sections.projects} wide>
        <div class="grid gap-4 md:grid-cols-2">
          {
            featured && (
              <div class="md:col-span-2">
                <ProjectCard project={featured} dict={dict} variant="featured" />
              </div>
            )
          }
          {
            paired && pairNote && (
              <p class="flex items-start gap-2 px-1 text-sm text-muted md:col-span-2">
                <span class="font-mono text-faint" aria-hidden="true">
                  ↳
                </span>
                <span>
                  <span class="font-medium text-fg">
                    {featured.name} + {paired.name}:
                  </span>{" "}
                  {pairNote}
                </span>
              </p>
            )
          }
          {rest.map((project) => <ProjectCard project={project} dict={dict} />)}
        </div>
      </Section>

      <Section id="how-i-work" index="04" title={dict.sections.howIWork} navGroup="projects">
        <ol class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {
            dict.howIWork.map((item, i) => (
              <li class="flex gap-3">
                <span class="pt-0.5 font-mono text-xs text-faint">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="text-sm font-medium">{item.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="education" index="05" title={dict.sections.education} navGroup="contact">
        <ol class="space-y-5">
          {
            dict.education.map((e) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <div>
                  <p class="font-medium">{e.degree}</p>
                  <p class="text-sm text-muted">{e.school}</p>
                </div>
                <p class="shrink-0 font-mono text-xs text-faint">{e.period}</p>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="contact" index="06" title={dict.sections.contact}>
        <p class="leading-relaxed text-fg/85">{dict.contact.text}</p>
        <a
          href={`mailto:${profile.email}`}
          class="group mt-5 inline-flex items-center gap-2 text-base font-medium break-all text-fg underline decoration-line decoration-1 underline-offset-[6px] transition-colors hover:decoration-fg/50 sm:text-lg"
        >
          {profile.email}
          <Icon
            name="arrow"
            class="size-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
        <div class="mt-4 flex flex-wrap gap-2">
          <a
            href={dict.cv.href}
            download={dict.cv.fileName}
            data-cv={lang}
            class="inline-flex items-center gap-1.5 rounded-lg bg-fg px-3 py-1.5 text-xs font-medium text-bg transition-opacity hover:opacity-85"
          >
            <Icon name="file" class="size-3.5" />
            {dict.ui.downloadCv}
          </a>
          <button
            type="button"
            data-copy={profile.email}
            data-label-copy={dict.ui.copyEmail}
            data-label-copied={dict.ui.copied}
            data-label-fallback={dict.ui.copyFallback}
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-bg/60 px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-fg/25 hover:text-fg"
          >
            <Icon name="copy" class="size-3.5" />
            <span data-copy-label aria-live="polite">{dict.ui.copyEmail}</span>
          </button>
        </div>
        <p class="mt-5 text-sm text-muted">
          {dict.contact.elsewhere}{" "}
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg/50">LinkedIn</a
          >{" "}
          {dict.contact.and}{" "}
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg/50">GitHub</a
          >.
        </p>
      </Section>
    </div>
  </main>

  <footer class="mx-auto max-w-3xl border-t border-line px-5 py-8 font-mono text-xs text-faint sm:px-8">
    © {year}
    {profile.name} · {dict.ui.footer}
  </footer>
  <script>
    import "../scripts/ui.ts";
  </script>
</Base>
