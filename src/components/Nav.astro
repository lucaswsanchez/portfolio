---
import Icon from "./Icon.astro";

const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<!-- Floating, centered pill navigation. -->
<header class="pointer-events-none fixed inset-x-0 top-3 z-40 flex justify-center px-4 sm:top-5">
  <nav
    aria-label="Main"
    class="nav-pill pointer-events-auto flex items-center gap-0.5 rounded-full border border-line bg-bg/70 p-1 shadow-[0_8px_30px_-12px_rgb(0_0_0/0.25)] backdrop-blur-xl backdrop-saturate-150 transition-[background-color,box-shadow] duration-300 [&.scrolled]:bg-bg/85 [&.scrolled]:shadow-[0_10px_40px_-12px_rgb(0_0_0/0.35)]"
  >
    <ul class="flex items-center">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav={l.href.slice(1)}
              class="block rounded-full px-3.5 py-1.5 text-sm text-muted transition-colors duration-200 hover:text-fg aria-[current]:bg-fg/[0.07] aria-[current]:text-fg"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="mx-1 h-4 w-px bg-line" aria-hidden="true"></span>
    <button
      id="theme-toggle"
      type="button"
      class="grid size-8 place-items-center rounded-full text-muted transition-colors duration-200 hover:bg-fg/[0.07] hover:text-fg"
      aria-label="Toggle dark mode"
    >
      <Icon name="moon" class="size-4 dark:hidden" />
      <Icon name="sun" class="hidden size-4 dark:block" />
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    const root = document.documentElement;
    const sync = () => btn.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    sync();
    btn.addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
      sync();
    });
    const pill = btn.closest("nav");
    const onScroll = () => pill.classList.toggle("scrolled", scrollY > 8);
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
