---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";

const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-transparent bg-bg/75 backdrop-blur-md transition-colors [&.scrolled]:border-line">
  <nav aria-label="Main" class="mx-auto flex h-14 max-w-3xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="font-mono text-sm font-medium tracking-tight" aria-label={`${profile.name}, back to top`}>
      {profile.initials}<span class="text-faint">.</span>
    </a>
    <div class="flex items-center gap-1">
      <ul class="flex items-center">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                data-nav={l.href.slice(1)}
                class="relative rounded-md px-2.5 py-1.5 text-sm text-muted transition-colors hover:text-fg aria-[current]:text-fg after:absolute after:inset-x-2.5 after:-bottom-px after:h-px after:origin-left after:scale-x-0 after:bg-fg/40 after:transition-transform after:duration-300 aria-[current]:after:scale-x-100"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 grid size-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <Icon name="moon" class="size-4 dark:hidden" />
        <Icon name="sun" class="hidden size-4 dark:block" />
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    const root = document.documentElement;
    const sync = () => btn.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    sync();
    btn.addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
      sync();
    });
    const header = btn.closest("header");
    const onScroll = () => header.classList.toggle("scrolled", scrollY > 8);
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
