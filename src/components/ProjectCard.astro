---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const iconFor = { demo: "arrow", docs: "book", code: "code" } as const;
const demo = project.links.find((l) => l.kind === "demo");
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-line bg-surface/70 transition-colors duration-300 hover:border-fg/20"
>
  {
    project.image && (
      <a
        href={demo?.href ?? project.links[0].href}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        class="block overflow-hidden border-b border-line bg-bg"
      >
        <Image
          src={project.image.src}
          alt=""
          widths={[480, 720, 1040]}
          sizes="(min-width: 768px) 560px, 100vw"
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
          class="aspect-[16/8] w-full object-cover object-top"
        />
      </a>
    )
  }

  <div class="flex flex-col p-5">
    <h3 class="font-semibold tracking-tight">{project.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{project.description}</p>
    {project.image && <p class="sr-only">Screenshot: {project.image.alt}</p>}

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${project.name} stack`}>
      {
        project.stack.map((tech) => (
          <li class="rounded-md border border-line bg-bg/60 px-2 py-0.5 font-mono text-[11px] text-muted">{tech}</li>
        ))
      }
    </ul>

    <div class="mt-5 flex flex-wrap gap-2">
      {
        project.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium transition-colors",
              link.kind === "demo"
                ? "bg-fg text-bg hover:opacity-85"
                : "border border-line bg-bg/60 text-fg hover:border-fg/25",
            ]}
          >
            <Icon name={iconFor[link.kind]} class="size-3.5" />
            {link.label}
            <span class="sr-only">for {project.name} (opens in a new tab)</span>
          </a>
        ))
      }
    </div>
  </div>
</article>
