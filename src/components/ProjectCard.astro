---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  variant?: "featured" | "compact";
}
const { project, variant = "compact" } = Astro.props;
const featured = variant === "featured";
const iconFor = { demo: "arrow", docs: "book", code: "code" } as const;
const demo = project.links.find((l) => l.kind === "demo");
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface/70 transition-colors duration-300 hover:border-fg/20"
>
  {
    project.image && (
      <a
        href={demo?.href ?? project.links[0].href}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        class="block border-b border-line bg-surface px-2.5 pt-2.5"
      >
        <!-- Screenshots sit in a small "window" frame so light captures don't clash with the dark theme. -->
        <Image
          src={project.image.src}
          alt=""
          widths={featured ? [480, 720, 1040, 1400] : [400, 560, 720]}
          sizes={featured ? "(min-width: 768px) 700px, 100vw" : "(min-width: 768px) 340px, 100vw"}
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
          class:list={[
            "w-full rounded-t-md object-cover object-top ring-1 ring-line dark:brightness-[0.88]",
            featured ? "aspect-[16/7]" : "aspect-[16/9]",
          ]}
        />
      </a>
    )
  }

  <div class:list={["flex flex-1 flex-col", featured ? "p-5 sm:p-6" : "p-4"]}>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <h3 class:list={["font-semibold tracking-tight", featured && "text-lg"]}>{project.name}</h3>
      {
        project.pairedWith && (
          <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[10.5px] text-muted">
            Tests {project.pairedWith.name}
          </span>
        )
      }
    </div>
    <p class:list={["mt-2 leading-relaxed text-muted", featured ? "text-[15px]" : "text-sm"]}>{project.description}</p>
    {project.image && <p class="sr-only">Screenshot: {project.image.alt}</p>}

    <ul
      class="mt-3 flex flex-wrap gap-x-3.5 gap-y-1 rounded-md bg-fg/[0.045] px-2.5 py-1.5 font-mono text-[11.5px] leading-snug text-fg/85"
      aria-label={`${project.name} highlights`}
    >
      {
        project.metrics.map((m) => (
          <li class="flex items-center gap-1.5">
            <span class="size-1 shrink-0 rounded-full bg-fg/40" aria-hidden="true" />
            {m}
          </li>
        ))
      }
    </ul>

    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`${project.name} stack`}>
      {
        project.stack.map((tech) => (
          <li class="rounded-md border border-line bg-bg/60 px-2 py-0.5 font-mono text-[11px] text-muted">{tech}</li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap gap-2 pt-4">
      {
        project.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium transition-colors",
              link.kind === "demo"
                ? "bg-fg text-bg hover:opacity-85"
                : "border border-line bg-bg/60 text-fg hover:border-fg/25",
            ]}
          >
            <Icon name={iconFor[link.kind]} class="size-3.5" />
            {link.label}
            <span class="sr-only">for {project.name} (opens in a new tab)</span>
          </a>
        ))
      }
    </div>
  </div>
</article>
