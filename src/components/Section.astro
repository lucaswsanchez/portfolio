---
interface Props {
  id: string;
  index: string;
  title: string;
  /** Nav link to highlight while this section is in view (defaults to its own id). */
  navGroup?: string;
}
const { id, index, title, navGroup } = Astro.props;
---

<section id={id} data-nav-group={navGroup} aria-labelledby={`${id}-title`} class="reveal grid gap-5 sm:grid-cols-[8.5rem_1fr] sm:gap-8">
  <h2 id={`${id}-title`} class="font-mono text-xs tracking-wide text-faint uppercase sm:pt-1">
    <span class="text-fg/70">{index}</span>
    <span aria-hidden="true"> — </span>
    {title}
  </h2>
  <div class="min-w-0">
    <slot />
  </div>
</section>
